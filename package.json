{
	"name": "skc-rcl",
	"version": "2.0.1",
	"description": "Component library for SKC Web and all other SKC Web sub domains.",
	"main": "dist/index.js",
	"module": "dist/index.es.js",
	"homepage": "http://ygo-skc.github.io/skc-rcl",
	"scripts": {
		"fresh-install": "rm -rf node_modules yarn.lock && yarn install",
		"start": "storybook dev -p 6006",
		"build": "rm -rf dist && rollup -c --configPlugin @rollup/plugin-typescript",
		"test": "jest",
		"test:i": "jest --watch",
		"build-storybook": "storybook build",
		"lint": "eslint src --ext .tsx",
		"deploy-storybook": "yarn run build-storybook && gh-pages -d storybook-static",
		"gh:deploy-storybook": "git remote set-url origin https://git:${GITHUB_TOKEN}@github.com/ygo-skc/skc-rcl.git && gh-pages -d storybook-static -u \"github-actions-bot <support+actions@github.com>\"",
		"publish": "yarn run build && npm login && yarn publish"
	},
	"keywords": [
		"skc",
		"skc-site"
	],
	"author": "Javi Gomez",
	"license": "MIT",
	"resolutions": {
		"trim-newlines": "5.0.0",
		"glob-parent": "6.0.2",
		"trim": "1.0.1",
		"react-inspector": "9.0.0",
		"react-element-to-jsx-string": "18.0.0",
		"@mdx-js/react": "3.1.1",
		"d3-color": "3.1.0",
		"@babel/traverse": "8.0.10",
		"@babel/core": "8.0.10",
		"postcss": "8.5.32",
		"react-dom": "19.3.1",
		"ws": "8.22.0",
		"body-parser": "2.4.0",
		"path-to-regexp": "9.0.0",
		"send": "1.2.1",
		"serve-static": "2.2.1",
		"express": "5.3.0",
		"cross-spawn": "7.0.6",
		"browserslist": "4.29.5",
		"brace-expansion": "5.0.12",
		"rollup": "4.67.2",
		"js-yaml": "5.5.0",
		"serialize-javascript": "7.1.4",
		"svgo": "4.1.0",
		"webpack-dev-middleware": "8.6.0",
		"postcss-selector-parser": "7.1.7"
	},
	"devDependencies": {
		"@babel/preset-env": "8.0.7",
		"@babel/preset-react": "8.0.1",
		"@babel/preset-typescript": "8.0.7",
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@eslint/eslintrc": "3.3.7",
		"@eslint/js": "10.0.1",
		"@mui/material": "9.5.0",
		"@nivo/pie": "0.99.0",
		"@rollup/plugin-babel": "7.1.0",
		"@rollup/plugin-image": "3.0.3",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@rollup/plugin-terser": "1.0.2",
		"@rollup/plugin-typescript": "12.3.1",
		"@storybook/addon-docs": "10.6.5",
		"@storybook/addon-links": "10.6.5",
		"@storybook/addon-webpack5-compiler-babel": "4.0.1",
		"@storybook/react-webpack5": "10.6.5",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/jest": "30.0.0",
		"@types/react": "19.3.0",
		"@types/rollup-plugin-peer-deps-external": "2.2.6",
		"@typescript-eslint/eslint-plugin": "8.72.1",
		"@typescript-eslint/parser": "8.72.1",
		"eslint": "10.14.0",
		"eslint-plugin-react": "7.37.5",
		"gh-pages": "6.3.0",
		"globals": "17.13.0",
		"jest": "30.5.2",
		"jest-environment-jsdom": "30.5.2",
		"jest-transform-css": "6.0.3",
		"react": "19.3.1",
		"rollup": "4.67.2",
		"rollup-plugin-dts": "6.5.1",
		"rollup-plugin-peer-deps-external": "2.2.4",
		"rollup-plugin-postcss": "4.0.2",
		"storybook": "10.6.5",
		"ts-jest": "29.4.15",
		"typescript": "6.0.3"
	},
	"peerDependencies": {
		"@emotion/styled": ">=11.11.0",
		"@mui/material": ">=9.0.0",
		"@nivo/pie": ">=0.99.0",
		"react": ">=19.0.0"
	},
	"files": [
		"dist"
	],
	"jest": {
		"setupFilesAfterEnv": [
			"<rootDir>/src/setupTests.ts"
		],
		"testEnvironment": "jsdom",
		"collectCoverage": true,
		"collectCoverageFrom": [
			"./src/**"
		],
		"coverageThreshold": {
			"global": {
				"branches": 10,
				"functions": 20,
				"lines": 20,
				"statements": 20
			}
		},
		"transformIgnorePatterns": [],
		"coveragePathIgnorePatterns": [
			"src/css/",
			"src/img/",
			"src/stories/",
			"src/index.ts",
			"src/global.d.ts"
		],
		"transform": {
			"^.+\\.tsx?$": "ts-jest",
			".+\\.(css|styl|less|sass|scss)$": "jest-transform-css",
			"^.+\\.svg$": "<rootDir>/config/jest/svgTransform.js"
		}
	}
}
